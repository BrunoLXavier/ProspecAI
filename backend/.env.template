# ProspecAI Backend Environment Variables

# Application
APP_NAME=ProspecAI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=prospecai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database - Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AUDIT_TOPIC=prospecai.audit
KAFKA_INGESTION_TOPIC=prospecai.ingestion

# Internal Authentication (replaces Keycloak)
# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (MailHog for development, configure SMTP for production)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@prospecai.local
SMTP_FROM_NAME=ProspecAI

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Encryption (Fernet key for SMTP passwords and sensitive data)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-generate-new-one

# Development mode bypass (set to false in production)
DEV_BYPASS_AUTH=true

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=prospecai

# External APIs
CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1
CNPJ_API_TIMEOUT=10

# Storage (MinIO for file uploads)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=prospecai-files
MINIO_SECURE=false

# Monitoring
PROMETHEUS_PORT=8001
GRAFANA_URL=http://localhost:3001

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
