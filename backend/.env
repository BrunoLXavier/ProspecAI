# ProspecAI Backend Environment Variables
# Development Configuration

# Application
APP_NAME=ProspecAI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database - PostgreSQL (Docker container)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=prospecai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/prospecai

# Database - Neo4j (Docker container)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Kafka (Docker container)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUDIT_TOPIC=prospecai.audit
KAFKA_INGESTION_TOPIC=prospecai.ingestion

# Internal Authentication (replaces Keycloak)
# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (MailHog for development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@prospecai.local
SMTP_FROM_NAME=ProspecAI

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Encryption (Fernet key for SMTP passwords and sensitive data)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-generate-new-one

# Development mode bypass (set to false in production)
DEV_BYPASS_AUTH=true

# Redis (Docker container)
REDIS_URL=redis://redis:6379/0
CACHE_L1_MAX_SIZE=1000
CACHE_L1_TTL_SECONDS=300
CACHE_L2_TTL_SECONDS=3600
CACHE_ENABLE_METRICS=true

# AI Models
TRANSFORMERS_CACHE=/app/model_cache
MODEL_CACHE_DIR=/app/model_cache
HF_HOME=/app/model_cache/huggingface
MODEL_REGISTRY_PATH=/app/models/registry.json
BERTIMBAU_MODEL=neuralmind/bert-base-portuguese-cased
BERTIMBAU_NER_MODEL=neuralmind/bert-base-portuguese-cased-ner

# MLflow (Docker container)
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=prospecai

# External APIs
CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1
CNPJ_API_TIMEOUT=10

# Storage (MinIO - Docker container)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=prospecai-files
MINIO_SECURE=false

# Monitoring
PROMETHEUS_PORT=8001
GRAFANA_URL=http://grafana:3000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
